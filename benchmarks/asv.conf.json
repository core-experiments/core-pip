{
  "version": 1,
  "project": "cpip",
  "project_url": "https://cpip.pypa.io/",
  "repo": "..",
  "branches": ["HEAD"],
  "benchmark_dir": ".",
  "environment_type": "virtualenv",
  "build_command": "python {build_dir}/benchmarks/asv_build.py wheel --no-deps -w {build_cache_dir} {build_dir}",
  "uninstall_command": [],
  "pythons": ["3.12"],
  "matrix": {
    "req": {
      "uv": ["0.12.1"]
    }
  },
  "env_dir": ".asv/env",
  "results_dir": ".asv/results",
  "html_dir": ".asv/html",
  "default_benchmark_timeout": 180
}
